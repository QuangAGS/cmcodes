// ============================================================================
// ONBOARDING CASE DOCTRINE
// ============================================================================

/// Phân loại hồ sơ onboarding.
/// MEMBER_JOIN: User đã có tenant và xin được ghép vào cây phả hệ.
/// CLAN_SETUP: Người sáng lập thiết lập tenant/dòng họ mới.
enum onboarding_case_type {
  MEMBER_JOIN
  CLAN_SETUP
}

/// Workflow state của hồ sơ onboarding.
/// Không dùng enum này thay cho users.status, members.status hoặc branches.status.
/// Đây là trạng thái của TOÀN BỘ HỒ SƠ / BUSINESS CASE.
enum onboarding_case_status {
  DRAFT /// User đang điền hồ sơ hoặc lưu nháp.
  PROFILE_COMPLETED /// Đã hoàn tất dữ liệu hồ sơ cốt lõi và đã tạo Member dự bị.
  FAMILY_TREE_DRAFT /// Đang xây dựng cây gia đình nhỏ / provisional branch.
  SUBMITTED /// User đã gửi hồ sơ; từ đây branch bị khóa chỉnh sửa.
  UNDER_REVIEW /// Admin đã nhận và đang thẩm định.
  NEEDS_REVISION /// Admin yêu cầu user bổ sung/chỉnh sửa.
  APPROVED /// Hồ sơ đã được duyệt về nghiệp vụ nhưng chưa chắc đã merge cây thành công.
  MERGING /// Hệ thống đang chạy transaction ghép nhánh vào cây chính thức.
  MERGED /// Ghép cây thành công; các Member liên quan đã trở thành CHINH_THUC.

  /// Hồ sơ được duyệt nhưng thao tác merge kỹ thuật thất bại.
  MERGE_FAILED /// Admin có thể retry merge sau khi xử lý nguyên nhân.
  REJECTED /// Admin từ chối hồ sơ.
  CANCELLED /// User tự hủy hồ sơ.
  EXPIRED /// Hồ sơ không hoàn tất trong thời hạn chính sách.
}

/// Trạng thái nghiệp vụ của branch.
/// Tách biệt với deleted_at.
/// deleted_at chỉ dành cho soft-delete kỹ thuật, không thay thế lịch sử workflow.
enum branch_status {
  DRAFT /// Branch đang được user soạn thảo.
  PROVISIONAL /// Branch dự bị, chưa có vị trí trong cây chính thức.
  SUBMITTED /// User đã gửi branch cùng onboarding case.
  UNDER_REVIEW /// Branch đang được CLAN_ADMIN hoặc reviewer thẩm định.
  APPROVED /// Branch đã được duyệt về nghiệp vụ.
  MERGED /// Branch đã được ghép vào cây phả hệ chung của dòng họ
  REJECTED /// Branch bị từ chối.
  ARCHIVED /// Branch bị lưu trữ, không hiển thị trong cây chính thức.
}
