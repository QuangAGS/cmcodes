// Thay toàn bộ model addresses trong schema.prisma
// Usage (quê / đang ở) KHÔNG nằm ở đây — vẫn members.origin_address_id / current_address_id

model addresses {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(36)
  tenant_id      String    @db.VarChar(36)
  country_code   String    @default("VN") @db.Char(2)
  postal_code    String?   @db.VarChar(20)
  admin_area     String?   @db.VarChar(100)
  locality       String?   @db.VarChar(100)
  sub_locality   String?   @db.VarChar(100)
  line1          String?   @db.VarChar(255)
  line2          String?   @db.VarChar(255)
  full_address   String    @db.VarChar(500)
  notes          String?   @db.VarChar(255)
  latitude       Decimal?  @db.Decimal(10, 8)
  longitude      Decimal?  @db.Decimal(11, 8)
  location_url   String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  changed_by     String?   @db.VarChar(36)
  deleted_at     DateTime? @db.Timestamptz(6)

  tenants   tenants @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_address_tenant")
  users     users?  @relation(fields: [changed_by], references: [id], onUpdate: NoAction, map: "fk_addresses_user")
  assets    assets[]
  branches  branches[]
  cemetery  cemetery[]
  events    events[]
  graves    graves[]
  residents members[] @relation("members_current_address_idToaddresses")
  natives   members[] @relation("members_origin_address_idToaddresses")
  worships  worships[]

  @@unique([tenant_id, country_code, full_address], map: "uq_addresses_tenant_country_full")
  @@index([tenant_id], map: "idx_address_tenant")
  @@index([country_code], map: "idx_address_country")
  @@index([admin_area], map: "idx_address_admin_area")
  @@index([changed_by], map: "idx_addresses_user")
  @@index([deleted_at], map: "idx_addresses_deleted_at")
  @@index([full_address(ops: raw("gin_trgm_ops"))], map: "trgm_idx_addresses_full_address", type: Gin)
  @@map("addresses")
}
