# DATETIME: 02-04-2026 17:00
# PATH: tests/registration_scenarios.http
# VERSION: 1.0.0
# DESCRIPTION: Kịch bản kiểm thử toàn diện quy trình Register, Login, Approve và Reject.

@baseUrl = https://gia-pha-backend.onrender.com/api
@systemAdminEmail = nguyenthanhq@gmail.com
@systemAdminPass = France@1989

##########################################################
### BƯỚC 0: ĐĂNG NHẬP SYSTEM ADMIN
##########################################################

# @name sysLogin
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "identifier": "{{systemAdminEmail}}",
  "password": "{{systemAdminPass}}"
}

##########################################################
### CASE 1: ĐĂNG KÝ TRỞ THÀNH CLAN_ADMIN (Tạo dòng họ mới)
##########################################################

### 1.1 Kiểm tra tính khả dụng của tên dòng họ/slug
# (Chạy riêng bước này nếu cần)
GET {{baseUrl}}/auth/check-slug?name=Họ Nguyễn Hữu HTTP/1.1
Content-Type: application/json

# Nếu API check-slug trả về gợi ý slug trong body, 
# bạn có thể đọc slug từ response thay vì hard-code.
# Tạm thời, dùng slug cố định để đơn giản:
@suggestedSlug = NH2026

### 1.2 Thực hiện đăng ký (Clan Admin mới)
# @name regClanAdmin
POST {{baseUrl}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "name": "Nguyễn Hữu Thành",
  "email": "thanh.nh@gmail.com",
  "password": "Password123",
  "isNewClan": true,
  "clanName": "Họ Nguyễn Hữu",
  "selectedSlug": "{{suggestedSlug}}",
  "change_reason": "Đăng ký khởi tạo dòng họ Nguyễn Hữu"
}

### 1.3 Thử đăng nhập ngay (mong đợi: bị chặn, status CHO_DUYET)
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "identifier": "thanh.nh@gmail.com",
  "password": "Password123"
}

### 1.4 SYSTEM_ADMIN phê duyệt CLAN_ADMIN
PATCH {{baseUrl}}/auth/approve/{{regClanAdmin.response.body.$.data.userId}} HTTP/1.1
Authorization: Bearer {{sysLogin.response.body.$.token}}
Content-Type: application/json

### 1.5 Đăng nhập lại sau khi đã được duyệt (Clan Admin Login)
# @name clanAdminLogin
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "identifier": "thanh.nh@gmail.com",
  "password": "Password123"
}

##########################################################
### CASE 2: ĐĂNG KÝ TRỞ THÀNH USER (Tham gia vào slug đã có)
##########################################################

### 2.1 Đăng ký User mới trong dòng họ vừa tạo
# @name regUser
POST {{baseUrl}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "name": "Nguyễn Hữu Bình",
  "email": "binh.nh@gmail.com",
  "password": "UserPass123",
  "isNewClan": false,
  "tenantId": "{{regClanAdmin.response.body.$.data.tenantId}}",
  "onboardingData": {
    "fullName": "Nguyễn Hữu Bình",
    "fatherName": "Nguyễn Hữu Thành",
    "relationship": "Con trai"
  }
}

### 2.2 CLAN_ADMIN phê duyệt USER
PATCH {{baseUrl}}/auth/approve/{{regUser.response.body.$.data.userId}} HTTP/1.1
Authorization: Bearer {{clanAdminLogin.response.body.$.token}}
Content-Type: application/json

##########################################################
### CASE 3: TỪ CHỐI ĐĂNG KÝ (Hard Delete / Dọn rác)
##########################################################

### 3.1 Tài khoản spam đăng ký dòng họ ảo
# @name regSpam
POST {{baseUrl}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "name": "Spam User",
  "email": "spam@test.com",
  "password": "SpamPassword",
  "isNewClan": true,
  "clanName": "Dòng họ Rác",
  "selectedSlug": "RAC123"
}

### 3.2 SYSTEM_ADMIN từ chối và xóa sạch dữ liệu (Hard Delete)
DELETE {{baseUrl}}/auth/reject/{{regSpam.response.body.$.data.userId}} HTTP/1.1
Authorization: Bearer {{sysLogin.response.body.$.token}}
Content-Type: application/json

{
  "reason": "Tên dòng họ không hợp lệ, có dấu hiệu spam hệ thống."
}

### 3.3 Kiểm tra spam user (mong đợi: login fail)
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "identifier": "spam@test.com",
  "password": "SpamPassword"
}