/**
 * THÊM ĐOẠN NÀY VÀO BACKEND ĐỂ TEST
 * CẢI TIẾN: Trả về chi tiết lỗi kết nối Database để Debug.
 */

app.get('/api/debug-db', async (req, res) => {
  try {
    // Nếu bạn dùng Prisma
    await prisma.$queryRaw`SELECT 1`;
    
    // Nếu bạn dùng Pool/Sequelize (ví dụ)
    // await db.authenticate(); 

    res.json({
      status: "Thành công",
      message: "Backend đã kết nối được tới Database!",
      db_url: process.env.DATABASE_URL ? "Đã cấu hình" : "Chưa có biến môi trường"
    });
  } catch (error) {
    res.status(500).json({
      status: "Thất bại",
      error_message: error.message,
      error_detail: error.original || error
    });
  }
});

// 8. KHỞI CHẠY SERVER
/**
 * FILE: index.js (Nằm ở thư mục gốc project Backend)
 * VERSION: 1.0.0
 * CHỨC NĂNG: Điểm khởi đầu (Entry Point) để chạy Server trên Render.
 */

const app = require('../../src/app'); // Import bộ não từ src/app.js

const PORT = process.env.PORT || 10000;
app.listen(PORT, '0.0.0.0', () => {
    console.log('====================================');
    console.log(`🌍 SERVER ĐANG CHẠY TRÊN CỔNG ${PORT}`);
    console.log(`🔓 Public: /api/auth`);
    console.log(`🔒 Private: /api/members, /api/branches...`);
    console.log('====================================');
});