# FILE: tests/common_crud_v13_tenant.http
# VERSION: 1.3.0
# DESCRIPTION: Kiểm tra việc tự động áp dụng tenant_id từ Token vào commonService.

@baseUrl = https://gia-pha-backend.onrender.com/api

### BƯỚC 1: LOGIN (Dòng họ NHTB01)
# Hệ thống trả về Token chứa thông tin của dòng họ này.
# @name login
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "identifier": "nguyenthanhq@gmail.com",
  "password": "France1989"
}

@authToken = {{login.response.body.$.token}}
@adminId = {{login.response.body.$.user.id}}
@targetTenantId = {{login.response.body.$.user.tenants.id}}

### BƯỚC 2: TẠO CHI NHÁNH (CREATE)
# Lưu ý: KHÔNG gửi tenant_id trong body, server tự lấy từ req.user.tenantId.
# @name createBranch
POST {{baseUrl}}/branches HTTP/1.1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Chi họ Nguyễn Đình - Nhánh Đông Hải",
  "description": "Nhánh con được tạo bởi Admin của NHTB01",
  "changed_by": "{{adminId}}",
  "change_reason": "Mở rộng cơ sở dữ liệu cho chi nhánh mới thành lập"
}

@branchId = {{createBranch.response.body.$.data.id}}

### BƯỚC 3: KIỂM TRA DỮ LIỆU THỰC TẾ
# Kiểm tra tenant_id trong DB có khớp với NHTB01 không.
GET {{baseUrl}}/branches/{{branchId}} HTTP/1.1
Authorization: Bearer {{authToken}}

### BƯỚC 4: KIỂM TRA AUDIT LOG
# Đảm bảo bảng audit_logs cũng ghi nhận đúng tenant_id của NHTB01.
GET {{baseUrl}}/audit_logs?record_id={{branchId}} HTTP/1.1
Authorization: Bearer {{authToken}}